{
  "name": "native-task-router",
  "version": "0.15.2",
  "private": true,
  "type": "module",
  "description": "说一句话，路由到你本机正确的 Claude Code / Codex 原生会话，在你自己的 iTerm / Terminal 里续上",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "install-electron",
    "check": "tsc --noEmit && bash scripts/shell-multibyte.guard.sh",
    "test": "npm run -s check && npm run -s providers:contracts && npm run -s iterm:contracts && npm run -s open:contracts && npm run -s terminal:contracts && npm run -s router:contracts && npm run -s route-eval:contracts && npm run -s voice:contracts && npm run -s addon:contracts && npm run -s package:contracts",
    "ntr": "node src/layers/cli.ts",
    "entry": "electron entry/main.cjs",
    "providers:contracts": "node scripts/layers-providers.contracts.mjs",
    "iterm:contracts": "node scripts/layers-iterm.contracts.mjs",
    "open:contracts": "node scripts/layers-open.contracts.mjs",
    "terminal:contracts": "node scripts/layers-terminal.contracts.mjs",
    "terminal:live": "node scripts/layers-terminal.live.mjs",
    "router:contracts": "node scripts/route-eval/contracts-router-v2.mjs && node scripts/route-eval/contracts-router-v3.mjs",
    "entry:ux": "node scripts/entry-ux.live.mjs",
    "voice:contracts": "node scripts/voice-wake.contracts.mjs",
    "iterm:live": "node scripts/layers-iterm.live.mjs",
    "open:live": "node scripts/layers-open.live.mjs",
    "route-eval:contracts": "node scripts/route-eval/contracts.mjs && node scripts/route-eval/contracts-v2.mjs",
    "route-eval:mine": "node scripts/route-eval/mine.mjs",
    "route-eval:mine2": "node scripts/route-eval/mine2.mjs",
    "route-eval:audit": "node scripts/route-eval/audit.mjs",
    "route-eval:run": "node scripts/route-eval/eval.mjs",
    "dist": "electron-builder --mac dmg --arm64",
    "addon:contracts": "node scripts/addon.contracts.mjs",
    "package:contracts": "node scripts/package-boundary.contracts.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "main": "entry/main.cjs",
  "author": "huajuan404",
  "build": {
    "appId": "dev.nativetaskrouter.app",
    "productName": "Native Task Router",
    "asar": false,
    "files": [
      "entry/main.cjs",
      "entry/addon.cjs",
      "entry/preload.cjs",
      "entry/updater.cjs",
      "entry/index.html",
      "entry/hotkey.html",
      "entry/wake.html",
      "entry/mic.html",
      "entry/assets/**",
      "src/**",
      "satellite/listen.mjs",
      "satellite/wake.mjs",
      "satellite/bpe-vocab.mjs",
      "satellite/fetch-models.sh",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "用来读取你唤起输入框时正在看的 iTerm / Terminal 标签页，并把这句话送进对应的 Claude Code / Codex 会话。",
        "NSMicrophoneUsageDescription": "只在你打开菜单栏「语音唤醒」时使用：听唤醒词「小卡拉米」和接着说的那句话，全程在本机识别，声音不离开这台 Mac。"
      }
    },
    "dmg": {
      "title": "Native Task Router"
    },
    "afterPack": "build/sign.cjs"
  },
  "dependencies": {
    "pinyin-pro": "3.29.5",
    "sherpa-onnx-node": "1.13.8"
  },
  "files": [
    "entry/main.cjs",
    "entry/addon.cjs",
    "entry/preload.cjs",
    "entry/updater.cjs",
    "entry/index.html",
    "entry/hotkey.html",
    "entry/wake.html",
    "entry/mic.html",
    "entry/assets/**",
    "src/**",
    "satellite/listen.mjs",
    "satellite/wake.mjs",
    "satellite/bpe-vocab.mjs",
    "satellite/fetch-models.sh",
    "package.json",
    "build/**",
    "scripts/**",
    "tsconfig.json",
    "satellite/package.json",
    "satellite/package-lock.json"
  ]
}
